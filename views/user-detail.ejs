<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Tableau de bord de gestion des réservations du Port de plaisance Russell.">
    <link rel="icon" href="/images/ship-wheel.png">
    <link rel="stylesheet" href="/stylesheets/main.css">
    <title>Utilisateurs - Port de plaisance Russell</title>
</head>
<body>
    <header class="header-form">
    <h1>Utilisateurs</h1>
</header>
<main>
<div class="table-form">
    <table class="table-cell">
        <thead>
            <tr>
                <th>Nom</th>
                <th>Email</th>
            </tr>
        </thead>
        <tbody>
          
            <tr>
                <td><%=targetUser.username%></td>
                <td><%=targetUser.email%></td>
            </tr>
    

        </tbody>
    </table>


<fieldset class="fieldset-form">
    <legend>Mettre à jour ou supprimer</legend>
    <form action="/users-view/<%=targetUser._id%>" method="post">
        <div class="input-form">
        <label for="username" > Nom </label>
        <input type="text" id="username" name="username" value="<%= targetUser.username %>">

        <label for="email"> Email</label>
        <input type="email" name="email" id="email" value="<%= targetUser.email %>">
        </div>
        
<div class="button-update-delete">
         <button type="submit">Modifier</button>
        
    </form>

     <form action="/users-view/<%=targetUser._id%>/delete" method="post">
        <button type="submit">Supprimer</button>

    </form>
</div>
   </fieldset>
<a href="/dashboard" class="link-form"> Retour au tableau de bord</a>
</div>
</main>
    
</body>
</html>